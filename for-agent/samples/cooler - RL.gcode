; start_gcode = M413 S0 ; disable Power Loss Recovery\nG90 ; use absolute coordinates\nM83 ; extruder relative mode\n\n; --- Initial Heating (Non-blocking) ---\nM140 S[first_layer_bed_temperature] ; start heating bed\n{if is_extruder_used[0]}M104 T0 S{first_layer_temperature[0]} ; start heating T0{endif}\n{if is_extruder_used[1]}M104 T1 S{first_layer_temperature[1]} ; start heating T1{endif}\n\n; --- Homing and Levelling ---\nG28 ; home all axis\nG29 L0 ; READ UBL from slot 0\nG29 A ; activate UBL\n\n\n; --- Move to Prime Position ---\nG1 Z10 F1200 ; raise Z for clearance\nG1 X20 Y0 F3000 ; move over the poop chute\n\n; --- Tool 0 Priming Sequence ---\n{if is_extruder_used[0]}\nM109 S{first_layer_temperature[0]} T0 ; wait for temp to reach target\nT0 ; select Tool 0\n\nG1 E70 F250 ; prime \nG1 E-10 F1500 ; retract to prevent oozing\nG92 E0 ; reset extruder coordinate\nM400\n{if initial_tool != 0}\nM104 S0 T0\n{endif}\n{endif}\n\n; --- Tool 1 Priming Sequence ---\n{if is_extruder_used[1]}\nM109 S{first_layer_temperature[1]} T1 ; wait for temperature to reach target\nT1 ; select Tool 1\n\nG1 E70 F250 ; prime\nG1 E-10 F1500 ; retract 5mm to prevent oozing\nG92 E0 ; reset extruder coordinate\nM400\n\n{if initial_tool != 1}\nM104 S0 T1\n{endif}\n{endif}\n\n; -- Move along front to make sure that the purged filament disconnects from nozzles ---\nG1 X180 Z0.5 F3000\nG1 X20 F3000\nG1 Z10 F300\n\nM400\n\n; --- Pre-Print State Restoration ---\nT[initial_tool] ; select the tool required for layer 1
